# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Translation cache (SQLite database)
*.db
*.db-shm
*.db-wal
translation_cache.db

# STRICT BOOK & DOCUMENT PROTECTION (User Privacy - Never Uploaded)
*.pdf
*.fb2
*.epub
*.mobi
*.djvu
*.azw3
*.doc
*.docx
*.cbr
*.cbz

# Upload and output folders
uploads/*
!uploads/.gitkeep
output/*
!output/.gitkeep
outputbook/
outputbook/*
books/
books/*
book/
book/*

# Virtual Environments
venv/
env/
.env
.venv

# IDE & OS files
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
